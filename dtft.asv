N = 10;
k = -30:1:30;

% Safe computation (avoids 0/0 using limit value = N)
numerator   = sin(k * (pi/5) * (5/2));
denominator = sin(k * (pi/10));

x1 = zeros(size(k));
for i = 1:length(k)
    if abs(denominator(i)) < 1e-10  
        x1(i) = N;
    else
        x1(i) = numerator(i) / denominator(i);
    end
end

figure;
stem(k, x1, 'filled');
xlabel('k');
ylabel('x_1[k]');
title('Dirichlet Kernel (N=10)');
grid on;
disp(x1);